{
  "name": "Lumen – Agent A : coordinateur de la collecte",
  "nodes": [
    {
      "id": "ac1",
      "name": "Toutes les 3 heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "ac2",
      "name": "Repères",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const CODES = [\"E9-boamp\", \"E1-place\", \"E2-aws\", \"E3-emp\", \"E4-maximilien\", \"E5-klekoon\", \"E6-ebourgogne\", \"E7-megalis\", \"E8-achatpublic\"];\nreturn [{ json: { debut: new Date().toISOString(), since: new Date(Date.now() - 48 * 36e5).toISOString(),\n  codes: CODES, filtre: 'agent=in.(' + CODES.join(',') + ')' } }];"
      }
    },
    {
      "id": "ac3",
      "name": "Lire les 9 sous-agents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://jsmffmtzoauvqltshiyg.supabase.co/rest/v1/agent_runs?{{ $json.filtre }}&debut=gte.{{ $json.since }}&select=agent,debut,statut&order=debut.desc&limit=500",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Lumen"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "id": "ac4",
      "name": "Compter les offres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://jsmffmtzoauvqltshiyg.supabase.co/rest/v1/offres?select=avis_id&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "count=exact"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Lumen"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "id": "ac5",
      "name": "Préparer le journal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const runs = $('Lire les 9 sous-agents').all().map(i => i.json);\nconst R = $('Repères').first().json, CODES = R.codes;\nconst parAgent = {};\nfor (const r of runs) { if (!parAgent[r.agent]) parAgent[r.agent] = r; } // déjà trié du plus récent au plus ancien\nconst manquants = CODES.filter(c => !parAgent[c]);\nconst enErreur = CODES.filter(c => parAgent[c] && parAgent[c].statut === 'erreur');\nconst aJour = CODES.length - manquants.length - enErreur.length;\nlet total = null;\ntry {\n  const cr = ($('Compter les offres').first().json.headers || {})['content-range'] || '';\n  const m = /\\/(\\d+)$/.exec(cr); total = m ? Number(m[1]) : null;\n} catch (e) {}\nlet statut = 'ok', message = null;\nif (manquants.length === CODES.length) { statut = 'vide'; message = \"Aucun des 9 sous-agents n'a encore de passage.\"; }\nelse if (enErreur.length) { statut = 'erreur'; message = enErreur.length + ' sous-agent(s) en erreur : ' + enErreur.join(', '); }\nelse if (manquants.length) { message = manquants.length + ' sous-agent(s) sans passage récent (48 h) : ' + manquants.join(', '); }\nreturn [{ json: { agent: 'A-collecteur', debut: R.debut, fin: new Date().toISOString(), statut,\n  entrees: CODES.length, sorties: aJour, details: { manquants, en_erreur: enErreur, offres_en_base: total }, message } }];"
      }
    },
    {
      "id": "ac6",
      "name": "Écrire le journal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://jsmffmtzoauvqltshiyg.supabase.co/rest/v1/agent_runs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Lumen"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    }
  ],
  "connections": {
    "Toutes les 3 heures": {
      "main": [
        [
          {
            "node": "Repères",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Repères": {
      "main": [
        [
          {
            "node": "Lire les 9 sous-agents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lire les 9 sous-agents": {
      "main": [
        [
          {
            "node": "Compter les offres",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compter les offres": {
      "main": [
        [
          {
            "node": "Préparer le journal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Préparer le journal": {
      "main": [
        [
          {
            "node": "Écrire le journal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}