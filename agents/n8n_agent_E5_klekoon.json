{
  "name": "Lumen – Agent E5 : Klekoon (klekoon.com)",
  "nodes": [
    {
      "id": "trig",
      "name": "Toutes les 24 heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "cmd",
      "name": "Lancer le navigateur",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "command": "node \"C:\\Users\\marin_3s4sfng\\Desktop\\Projet\\Lumenmarket\\Lument_agents\\E5-klekoon\\e5-klekoon.js\""
      }
    },
    {
      "id": "prep",
      "name": "Préparer le journal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const sortie = $('Lancer le navigateur').first().json;\nlet r = { offres: [], total: 0, erreur: \"Sortie du script illisible : \" + String(sortie.stdout || '').slice(0, 200) };\ntry { r = JSON.parse(sortie.stdout); } catch (e) {}\nif (sortie.exitCode && sortie.exitCode !== 0) r.erreur = r.erreur || ('Le script a échoué (code ' + sortie.exitCode + ') : ' + String(sortie.stderr || '').slice(0, 300));\nreturn [{ json: { debut: new Date().toISOString(), offres: r.offres || [], total: r.total || 0, erreur: r.erreur || null } }];"
      }
    },
    {
      "id": "ecrire",
      "name": "Enregistrer les offres",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://jsmffmtzoauvqltshiyg.supabase.co/rest/v1/offres?on_conflict=avis_id",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.offres) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Lumen"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "id": "prep2",
      "name": "Préparer le journal agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const c = $('Préparer le journal').first().json;\nlet statut = 'ok', message = null;\nconst erreurs = $input.all().map(i => i.json).filter(x => x && x.error);\nif (erreurs.length) { statut = 'erreur'; message = 'Enregistrement dans Supabase impossible : ' + JSON.stringify(erreurs[0].error).slice(0, 300); }\nelse if (c.erreur && !c.total) { statut = 'erreur'; message = c.erreur; }\nelse if (c.erreur) { message = c.erreur; }\nelse if (!c.total) statut = 'vide';\nreturn [{ json: { agent: 'E5-klekoon', debut: c.debut, fin: new Date().toISOString(), statut, entrees: c.total, sorties: statut === 'erreur' ? 0 : c.total, details: {}, message } }];"
      }
    },
    {
      "id": "jrn",
      "name": "Écrire le journal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://jsmffmtzoauvqltshiyg.supabase.co/rest/v1/agent_runs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase Lumen"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    }
  ],
  "connections": {
