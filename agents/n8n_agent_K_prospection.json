    {
      "id": "k8c",
      "name": "Composer le mail final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $input.item.json;\nconst x = $('Préparer résumé IA').item.json;\nconst res = String(r.choices?.[0]?.message?.content || '').trim();\nif (!res) throw new Error('Résumé OpenAI manquant.');\n\nconst prenom = x.dirigeant ? x.dirigeant.trim().split(/\\s+/)[0] : '';\nconst h = prenom ? 'Bonjour ' + prenom + ',' : 'Bonjour,';\nconst amt = x.amount || 'montant non indiqué';\nconst date = x.deadline || 'Non précisée';\nconst LOGO = 'https://lumen-marches.pages.dev/logo-signature.png?v=2';\nconst LOGO_ICONE = 'https://lumen-marches.pages.dev/logo-icone.png?v=2';   // icône seule, pour la signature\nconst SITE = 'https://lumen-marches.pages.dev/';\nconst INSCRIPTION = SITE + 'inscription.html';\nconst LEGAL = 'Lumen IA, SIRET 985 215 474 00018, 205 chemin de la Halte, 13090 Aix-en-Provence · lumeniaindustrie@gmail.com';\n\n// --- version texte (fallback) ---\nconst t = [\n  h, '',\n  \"J’ai repéré une opportunité de marché public dans le \" + x.offer_department + \" qui pourrait correspondre à l’activité de \" + x.entreprise + \" :\",\n  '',\n  'Objet : ' + x.offer_object,\n  'Résumé : ' + res,\n  'Département : ' + x.offer_department,\n  'Montant : ' + amt,\n  'Date limite : ' + date,\n  '',\n  \"Lumen surveille les marchés publics liés au domaine de \" + x.activite + \" sur \" + x.platforms + \". Les nouvelles offres correspondant à votre activité vous sont envoyées par email chaque matin de semaine. Vous pouvez gagner jusqu’à 6 heures de veille par semaine et repérer les offres plus rapidement !\",\n  '',\n  \"Découvrez Lumen avec 7 jours d’essai gratuit :\",\n  'Commencer mon essai gratuit : ' + INSCRIPTION,\n  '',\n  \"Bien cordialement,\",\n  'Sauzay Marin',\n  'Fondateur de Lumen',\n  '',\n  \"Pour ne plus recevoir de messages de Lumen, répondez simplement « STOP ».\",\n  LEGAL\n];\n\n// --- version HTML (soignée, compatible clients mail) ---\nconst esc = s => String(s).replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n\nconst htmlContent = `<!doctype html>\n<html>\n<body style=\"margin:0;padding:0;background:#F6F7F9;font-family:Arial,Helvetica,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F6F7F9;padding:28px 0;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FFFFFF;border-radius:14px;overflow:hidden;border:1px solid #E6E8EC;\">\n\n  <tr><td style=\"padding:22px 32px;border-bottom:1px solid #E6E8EC;\">\n    <img src=\"${LOGO}\" width=\"180\" height=\"29\" alt=\"Lumen Marchés\" style=\"display:block;border:0;width:180px;height:29px;\">\n  </td></tr>\n\n  <tr><td style=\"padding:32px 32px 8px;\">\n    <p style=\"margin:0 0 16px;font-size:15px;color:#171A21;\">${esc(h)}</p>\n    <p style=\"margin:0 0 20px;font-size:15px;line-height:1.6;color:#171A21;\">J’ai repéré une opportunité de marché public dans le <b>${esc(x.offer_department)}</b> qui pourrait correspondre à l’activité de <b>${esc(x.entreprise)}</b> :</p>\n\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#EEF2FC;border-radius:10px;margin-bottom:22px;\">\n      <tr><td style=\"padding:20px 22px;\">\n        <p style=\"margin:0 0 10px;font-size:12px;font-weight:700;color:#2350C4;text-transform:uppercase;letter-spacing:.04em;\">Marché public repéré</p>\n        <p style=\"margin:0 0 8px;font-size:15px;font-weight:700;color:#171A21;\">${esc(x.offer_object)}</p>\n        <p style=\"margin:0 0 14px;font-size:14px;line-height:1.55;color:#6B7280;\">${esc(res)}</p>\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:13px;width:100%;\">\n          <tr><td style=\"padding:3px 0;color:#6B7280;width:110px;\">Département</td><td style=\"padding:3px 0;color:#171A21;font-weight:600;\">${esc(x.offer_department)}</td></tr>\n          <tr><td style=\"padding:3px 0;color:#6B7280;\">Montant</td><td style=\"padding:3px 0;color:#171A21;font-weight:600;\">${esc(amt)}</td></tr>\n          <tr><td style=\"padding:3px 0;color:#6B7280;\">Date limite</td><td style=\"padding:3px 0;color:#171A21;font-weight:600;\">${esc(date)}</td></tr>\n        </table>\n      </td></tr>\n    </table>\n\n    <p style=\"margin:0 0 24px;font-size:15px;line-height:1.6;color:#171A21;\">Lumen surveille les marchés publics liés au domaine de <b>${esc(x.activite)}</b> sur ${esc(x.platforms)}. Les nouvelles offres correspondant à votre activité vous sont envoyées par email chaque matin de semaine — jusqu’à <b>6 heures de veille gagnées par semaine</b>.</p>\n\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 28px;\">\n      <tr><td style=\"border-radius:8px;background:#2350C4;\">\n        <a href=\"${INSCRIPTION}\" style=\"display:inline-block;padding:13px 26px;font-size:14px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:8px;\">Commencer mon essai gratuit (7 jours)</a>\n      </td></tr>\n    </table>\n\n    <p style=\"margin:0;font-size:15px;color:#171A21;\">Bien cordialement,</p>\n  </td></tr>\n\n  <tr><td style=\"padding:4px 32px 28px;\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #E6E8EC;width:100%;\">\n      <tr>\n        <td style=\"padding-top:18px;vertical-align:middle;width:72px;\"><img src=\"${LOGO_ICONE}\" width=\"40\" height=\"29\" alt=\"Lumen\" style=\"display:block;border:0;width:40px;height:29px;\"></td>\n        <td style=\"padding-top:18px;vertical-align:middle;padding-left:14px;border-left:1px solid #E6E8EC;font-size:13px;color:#171A21;line-height:1.5;\">\n          <b>Sauzay Marin</b><br>Fondateur de Lumen Marchés<br><a href=\"${SITE}\" style=\"color:#2350C4;text-decoration:none;\">lumen-marches.pages.dev</a>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n\n  <tr><td style=\"background:#F6F7F9;padding:16px 32px;border-top:1px solid #E6E8EC;\">\n    <p style=\"margin:0;font-size:12px;color:#6B7280;\">Pour ne plus recevoir de messages de Lumen, répondez simplement « STOP ».</p>\n    <p style=\"margin:6px 0 0;font-size:11px;color:#9CA3AF;\">${LEGAL}</p>\n  </td></tr>\n\n</table>\n</td></tr>\n</table>\n</body>\n</html>`;\n\nreturn { json: { ...x, textContent: t.join('\\n'), htmlContent } };\n"
      }
    },
